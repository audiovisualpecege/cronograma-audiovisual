# Endereço e chave pública do Supabase, lidos no build do app (nada secreto: a proteção é a RLS, ADR-008).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Chave pública VAPID das notificações no celular: a mesma VAPID_PUBLIC_KEY do .env do serviço de fundo no NAS.
VITE_VAPID_PUBLIC_KEY=
