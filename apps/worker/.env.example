# Configuração do serviço de fundo no NAS. Copie para .env (que nunca vai para o Git) e preencha.

# Projeto Supabase: Project Settings > API. A chave service_role fica só aqui, no NAS; nunca no app.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Endereço do app web publicado. O convite leva a pessoa para <APP_URL>#/criar-senha.
# Este endereço precisa estar em Authentication > URL Configuration do Supabase.
APP_URL=https://audiovisualpecege.github.io/cronograma-audiovisual/

# Conta de serviço do Google Cloud com a Calendar API ativa (só leitura). O docker-compose.yml monta o
# JSON baixado do Google em /run/segredos/google-service-account.json; fora do Docker, aponte o caminho
# aqui ou cole o JSON inteiro numa linha em GOOGLE_SERVICE_ACCOUNT_JSON.
# GOOGLE_SERVICE_ACCOUNT_FILE=/caminho/para/google-service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Chaves VAPID das notificações no celular. Gere uma vez com:
#   npx web-push generate-vapid-keys
# A chave pública também vai no build do app web. Sem elas, os avisos ficam só dentro da plataforma.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:audiovisualpecege@gmail.com

# Opcionais
# Nível dos logs JSON: trace, debug, info, warn, error.
LOG_LEVEL=info
# Consulta de reserva da fila e dos avisos, além do tempo real, em segundos.
QUEUE_POLL_SECONDS=30

# A chave do Gemini não fica aqui: o administrador a informa na tela de configuração da IA, ela é testada
# e guardada no Supabase (private.secrets), lida só por este serviço.

# IA local (MiniCPM5 ou outro, num servidor Ollama, llama.cpp, LM Studio ou vLLM). O normal é informar o
# endereço na tela de configuração; estes valem quando o banco ainda não tem o campo (antes da migração 0014),
# por exemplo para testar num computador. Ver docs/ia-local.md.
# AI_LOCAL_URL=http://localhost:11434
# AI_LOCAL_MODEL=minicpm5
